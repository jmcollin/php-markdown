{
  "name": "php-markdown/parser",
  "description": "Lightweight standalone CommonMark Markdown to HTML5 parser — no external dependencies",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Jean-Marie Collin",
      "homepage": "https://github.com/jmcollin"
    }
  ],
  "require": {
    "php": ">=8.3",
    "ext-ctype": "*",
    "ext-intl": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11"
  },
  "autoload": {
    "psr-4": {
      "PhpMarkdown\\": "src/"
    },
    "exclude-from-classmap": ["tests/"]
  },
  "autoload-dev": {
    "psr-4": {
      "PhpMarkdown\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
